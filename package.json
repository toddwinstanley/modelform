{
  "name": "modelform",
  "version": "0.1.0",
  "private": true,
  "description": "Render Grafana-compatible dashboard JSON, and input forms in the same format, as native React Native panels.",
  "keywords": [
    "react-native",
    "expo",
    "grafana",
    "dashboard",
    "charts",
    "forms",
    "json"
  ],
  "license": "MIT",
  "author": "Todd Winstanley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toddwinstanley/modelform.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./metro": "./tools/metro.js",
    "./dashboards": "./tools/dashboards.js",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "modelform": "tools/dashboards.js"
  },
  "files": [
    "dist",
    "schema",
    "tools/metro.js",
    "tools/dashboards.js"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.mjs",
        "require": "./dist/core/index.js"
      },
      "./metro": "./tools/metro.js",
      "./dashboards": "./tools/dashboards.js",
      "./schema/*": "./schema/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "node tools/schema.js"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "ts-json-schema-generator": "2.9.0",
    "tsup": "8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  }
}
